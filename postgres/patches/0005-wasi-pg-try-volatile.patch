+/*
+ * pgmem: wazero v1.12.0's exception handling is not spec-conformant: when it
+ * catches an exception, a function's wasm locals revert to their values at
+ * try_table entry. LLVM's setjmp lowering wraps the whole function body in
+ * one try_table, so PG_CATCH would restore stale values, and a re-thrown
+ * ERROR would find no handler and become FATAL. volatile keeps the two saved
+ * values in linear memory, which wazero does not roll back. This is only a
+ * mitigation: other setjmp code that reads a non-volatile local after
+ * longjmp stays exposed until wazero is fixed.
+ */
+#ifdef __wasi__
+#define PG_TRY_VOLATILE volatile
+#else
+#define PG_TRY_VOLATILE
+#endif
 #define PG_TRY(...)  \
