--- a/src/include/miscadmin.h
+++ b/src/include/miscadmin.h
@@ -301,6 +301,51 @@
 extern void check_stack_depth(void);
 extern bool stack_is_too_deep(void);
 
+#ifdef __wasi__
+/*
+ * pgmem: under WebAssembly, stack_is_too_deep() sees only the shadow stack in
+ * linear memory, which holds just the locals whose address is taken. The
+ * engine's own stack (wazero's) holds everything else. It grows 3 to 16
+ * times faster, and the JSON parser's recursion puts nothing on the shadow
+ * stack at all, so a deep enough input overflowed the engine stack, a trap
+ * that crashes the backend, without ever reaching max_stack_depth.
+ *
+ * So every depth check reserves PGMEM_STACK_CHECK_PAD bytes of shadow stack
+ * in its caller's frame, for as long as that frame lives. A recursion that
+ * checks its depth once per level, as Postgres's recursions do, then grows
+ * the shadow stack by at least that much per level, and max_stack_depth
+ * bounds its depth. 256 bytes keeps the engine stack within about 4 times
+ * the shadow stack for every recursion measured (JSON, jsonb, plpgsql, SQL
+ * functions, expressions, set operations, regular expressions). Postgres's
+ * own frames stay where they were: unwinding, including longjmp, releases
+ * the pads with them. The pad is never touched; storing its address keeps
+ * the compiler from dropping it. get_stack_depth_rlimit() in postgres.c
+ * sets the matching max_stack_depth.
+ *
+ * The invariant: the check must sit in a frame that stays live across the
+ * recursive call, so that each level's pad is still reserved while the
+ * next level runs. A check made in a helper that returns before the
+ * recursion releases its pad at once and bounds nothing. The bound is
+ * empirical: kinds not probed include deeply nested plans of other node
+ * types, nested subqueries and views, deep parse trees outside
+ * expressions, XML and jsonpath, and array and record I/O.
+ */
+#define PGMEM_STACK_CHECK_PAD 256
+extern char *volatile pgmem_stack_pad_sink;
+#define check_stack_depth() \
+	do { \
+		char		pgmem_stack_pad_[PGMEM_STACK_CHECK_PAD]; \
+		pgmem_stack_pad_sink = pgmem_stack_pad_; \
+		(check_stack_depth) (); \
+	} while (0)
+#define stack_is_too_deep() \
+	({ \
+		char		pgmem_stack_pad_[PGMEM_STACK_CHECK_PAD]; \
+		pgmem_stack_pad_sink = pgmem_stack_pad_; \
+		(stack_is_too_deep) (); \
+	})
+#endif
+
