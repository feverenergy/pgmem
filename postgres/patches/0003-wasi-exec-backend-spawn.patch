+	 */
+	{
+		extern char **environ;
+		sigset_t	save_mask;
+		int			save_errno;
 
+		argv[0] = postgres_exec_path;
+		fflush(NULL);
+		sigprocmask(SIG_SETMASK, &BlockSig, &save_mask);
+		pid = pgmem_spawn(argv, environ, NULL, 0);
+		save_errno = errno;
+		if (pid < 0)
+			unlink(tmpfilename);
+		sigprocmask(SIG_SETMASK, &save_mask, NULL);
+		errno = save_errno;
+	}
+#else
